{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/testimonials/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/diagnostic",
      "destination": "https://expert-clone-diagnostic.vercel.app/",
      "permanent": false
    },
    {
      "source": "/diagnostic/:path*",
      "destination": "https://expert-clone-diagnostic.vercel.app/",
      "permanent": false
    }
  ]
}
